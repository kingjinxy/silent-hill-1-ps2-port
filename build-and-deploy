#!/bin/bash
# Builds the port's ISO (build/port/sh1_ps2.iso) and serves it to the PS2 (Neutrino over UDPFS).
#
#   ./build-and-deploy              build; if the server is running, switch it to the new ISO and
#                                   restart the game on the PS2; if not, start the server (and the
#                                   console log receiver), then boot the PS2 yourself
#   ./build-and-deploy --restart    also stop and start the server and log receiver fresh first
#   ./build-and-deploy --no-build   skip the build (serve / deploy the ISO as it is)
#   ./build-and-deploy --prof       profiling build (SH1_PROF=1: counters printed to the log)
#
# The server and log receiver are the HAL's (../psx-to-ps2-HAL/tools/udpfs_serve.py, tools/ps2_log.py),
# shared with the Metal Gear Solid port: one server serves ~/ps2serve/, which links to both games' images
# (sh1_ps2.iso and mgs_ps2.iso), and the console log goes to ~/ps2serve/ps2.log (build/port/ps2.log links
# to it). The game is chosen on the PS2 by the Neutrino folder started (neutrino boots sh1_ps2.iso). A deploy
# restarts whichever game is running.
#
# Server output: ~/ps2serve/udpfs_server.log; log receiver output: ~/ps2serve/ps2_log.out.
# Build options can also come from the environment (SH1_FPS, SH1_PROF, SH1_BENCH, ...; see
# tools/port/port_link.py and tools/port/ee_compile_check.sh).
set -e
cd "$(dirname "$0")"

RESTART=0
BUILD=1
for arg in "$@"; do
    case "$arg" in
        --restart) RESTART=1 ;;
        --no-build) BUILD=0 ;;
        --prof) export SH1_PROF=1 ;;
        -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
        *) echo "unknown option: $arg (see --help)"; exit 1 ;;
    esac
done

source .venv/bin/activate
export SH1_FPS=${SH1_FPS:-60} SH1_NO_RECOMP=${SH1_NO_RECOMP:-1}

if [ "$BUILD" = 1 ]; then
    echo "== building (SH1_FPS=$SH1_FPS${SH1_PROF:+, profiling})"
    bash tools/port/ee_compile_check.sh > build/port/build_compile.log 2>&1 || {
        echo "compile failures (build/port/build_compile.log):"; tail -n 20 build/port/build_compile.log; exit 1; }
    python3 tools/port/port_link.py > build/port/build_link.log 2>&1 || {
        echo "link failed (build/port/build_link.log):"; tail -n 20 build/port/build_link.log; exit 1; }
    bash tools/port/make_iso.sh > build/port/build_iso.log 2>&1 || {
        echo "ISO failed (build/port/build_iso.log):"; tail -n 20 build/port/build_iso.log; exit 1; }
    echo "   $(strings build/port/sh1.elf | grep -o 'build [A-Z][a-z][a-z] [ 0-9]* [0-9]* [0-9:]*' | head -1)"
fi

HAL=$(realpath ../psx-to-ps2-HAL)
SERVE=~/ps2serve
mkdir -p "$SERVE"

# This game's image and log in the shared folder.
ln -sfn "$(realpath build/port/sh1_ps2.iso)" "$SERVE/sh1_ps2.iso"
touch "$SERVE/ps2.log"
[ -L build/port/ps2.log ] || { [ -f build/port/ps2.log ] && cat build/port/ps2.log >> "$SERVE/ps2.log"; rm -f build/port/ps2.log; }
ln -sfn "$SERVE/ps2.log" build/port/ps2.log

running() { pgrep -f "$HAL/tools/$1" > /dev/null; }

# This repository's own server and log receiver (tools/port/, from before they were shared) hold the
# same ports: started with relative paths from here, found by command line and working directory.
for p in udpfs_serve.py ps2_log.py; do
    for pid in $(pgrep -f "tools/port/$p"); do
        [ "$(readlink "/proc/$pid/cwd")" = "$(pwd -P)" ] || continue
        echo "== stopping the old tools/port/$p (pid $pid): the HAL's shared one replaces it"
        kill "$pid" 2>/dev/null || true
        sleep 1
    done
done

if [ "$RESTART" = 1 ]; then
    echo "== stopping the server and log receiver"
    for p in udpfs_serve.py ps2_log.py; do
        for pid in $(pgrep -f "$HAL/tools/$p"); do kill "$pid" 2>/dev/null || true; done
    done
    sleep 1
fi

STARTED=0
if ! running udpfs_serve.py; then
    echo "== starting the UDPFS server ($SERVE/udpfs_server.log)"
    nohup python3 -u "$HAL/tools/udpfs_serve.py" --root "$SERVE" > "$SERVE/udpfs_server.log" 2>&1 &
    STARTED=1
fi
if ! running ps2_log.py; then
    echo "== starting the console log receiver ($SERVE/ps2_log.out)"
    nohup python3 -u "$HAL/tools/ps2_log.py" --log "$SERVE/ps2.log" >> "$SERVE/ps2_log.out" 2>&1 &
fi

if [ "$STARTED" = 1 ]; then
    echo "== server started: boot the game on the PS2 (Neutrino) now"
    exit 0
fi

echo "== switching the server to the new ISO and restarting the game"
echo "   (this restarts whichever game the PS2 is running: if it's Metal Gear Solid, power-cycle and start neutrino)"
if timeout 40 python3 tools/port/ps2_ctl.py deploy; then
    echo "   done; if the PS2 doesn't come back within ~30 s, power-cycle it (hold power to switch off) and start Neutrino again: it will load the new ISO"
else
    echo "   the PS2 didn't answer (frozen or off): power-cycle it and start Neutrino again; it will load the new ISO"
fi
